<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netcoreapp8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Assets\Font\Hind-Regular.ttf" />
    <None Remove="Assets\Font\Hind-SemiBold.ttf" />
    <None Remove="Assets\Hind-Bold.ttf" />
    <None Remove="Assets\Hind-Light.ttf" />
    <None Remove="Assets\Hind-Medium.ttf" />
    <None Remove="Assets\Images\Logo.png" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\Font\Hind-Bold.ttf" />
    <EmbeddedResource Include="Assets\Font\Hind-Light.ttf" />
    <EmbeddedResource Include="Assets\Font\Hind-Medium.ttf" />
    <EmbeddedResource Include="Assets\Font\Hind-Regular.ttf" />
    <EmbeddedResource Include="Assets\Font\Hind-SemiBold.ttf" />
    <EmbeddedResource Include="Assets\Images\Logo.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" Version="7.3.0.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.1" />
    <PackageReference Include="QuestPDF" Version="2023.12.6" />
    <PackageReference Include="SkiaSharp" Version="2.88.8" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="2.88.8" />
  </ItemGroup>

</Project>
